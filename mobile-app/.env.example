# Copy to .env.local (gitignored) and edit. EXPO_PUBLIC_* values are compiled
# into the app bundle — never put a secret in one.

# "fixture" — recorded COCOON backend output + M0 samples, labelled DEMO DATA (default)
# "api"     — the FastAPI backend at EXPO_PUBLIC_API_URL
EXPO_PUBLIC_DATA_PROVIDER=fixture

# Backend base URL (no trailing path). Required when the provider is "api".
# From an Android emulator the host machine is 10.0.2.2; from a phone use the
# computer's LAN address. Production builds must use https://.
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# development | staging | production — request logging is on in development only.
EXPO_PUBLIC_APP_ENV=development

# Request timeout in milliseconds (default 30000).
# EXPO_PUBLIC_API_TIMEOUT_MS=30000
