{
  "$defs": {
    "AnsysArtifactManifest": {
      "additionalProperties": false,
      "description": "Catalog and cryptographic hashes of files generated by an ANSYS run.",
      "properties": {
        "artifacts": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Map of artifact logical name to relative file path or URI",
          "title": "Artifacts",
          "type": "object"
        },
        "checksums_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "SHA-256 hashes of generated artifacts",
          "title": "Checksums Sha256",
          "type": "object"
        }
      },
      "required": [
        "artifacts",
        "checksums_sha256"
      ],
      "title": "AnsysArtifactManifest",
      "type": "object"
    },
    "AnsysComparisonMetrics": {
      "additionalProperties": false,
      "description": "Statistical agreement metrics comparing independent RC and ANSYS thermal results.",
      "properties": {
        "bias_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mean signed bias (ANSYS - RC) in \u00b0C",
          "title": "Bias C"
        },
        "mae_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mean Absolute Error in \u00b0C",
          "title": "Mae C"
        },
        "max_abs_error_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum Absolute Error in \u00b0C",
          "title": "Max Abs Error C"
        },
        "r_squared": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Coefficient of determination [0..1]",
          "title": "R Squared"
        },
        "rmse_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Root Mean Squared Error in \u00b0C",
          "title": "Rmse C"
        }
      },
      "title": "AnsysComparisonMetrics",
      "type": "object"
    },
    "AnsysJobStatus": {
      "description": "Finite state machine for ANSYS validation jobs strictly matching PRD Section 14.9.",
      "enum": [
        "NOT_REQUESTED",
        "QUEUED",
        "PREPARING",
        "MESHING",
        "SOLVING",
        "EXPORTING",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "TIMED_OUT",
        "UNAVAILABLE"
      ],
      "title": "AnsysJobStatus",
      "type": "string"
    }
  },
  "$id": "https://cocoon.drdo.in/schemas/v4/ansys-validation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "AUTO-GENERATED: DO NOT EDIT DIRECTLY. Canonical source: AnsysValidationResult in cocoon_contracts. Outcome and comparison package produced by the ANSYS validation worker.",
  "properties": {
    "artifacts": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnsysArtifactManifest"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Rendered PNGs, series CSVs, and logs"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Completion timestamp",
      "title": "Completed At"
    },
    "design_revision_id": {
      "description": "Target design revision ID (rev_...)",
      "title": "Design Revision Id",
      "type": "string"
    },
    "error_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Explanation if job failed, cancelled, or unavailable",
      "title": "Error Reason"
    },
    "job_id": {
      "description": "ANSYS job identifier starting with 'ans_'",
      "title": "Job Id",
      "type": "string"
    },
    "metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnsysComparisonMetrics"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Comparison metrics against RC"
    },
    "schema_version": {
      "const": "4.0",
      "description": "Contract schema version, strictly '4.0'",
      "title": "Schema Version",
      "type": "string"
    },
    "solver_summary": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Mesh nodes/elements and solver log stats",
      "title": "Solver Summary"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Worker pickup timestamp",
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/AnsysJobStatus",
      "description": "Terminal or active execution status"
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "design_revision_id",
    "status"
  ],
  "title": "AnsysValidationResult",
  "type": "object"
}
