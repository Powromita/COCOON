# Server-only configuration. Copy to backend/.env and replace placeholders.
# Never commit backend/.env or expose SUPABASE_SECRET_KEY to the browser.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
COCOON_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
